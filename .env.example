# Sanity.io Configuration
# Your Sanity project ID from https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=c45te99f
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-03-01

# Sanity API Write Token for saving guestbook messages directly to Sanity
# Generate from https://www.sanity.io/manage/project/c45te99f/api#tokens with Editor role
# 1. On Vercel: Add this as SANITY_WRITE_TOKEN in Project Settings -> Environment Variables
SANITY_WRITE_TOKEN=
# 2. Optional for local development fallback:
VITE_SANITY_WRITE_TOKEN=
