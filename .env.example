# Sanity.io Configuration
# Replace with your Sanity project ID from https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
# Optional: Sanity API Write Token for saving guestbook messages directly from web
# Generated from https://www.sanity.io/manage/project/<projectId>/api#tokens with Editor role
VITE_SANITY_WRITE_TOKEN=
